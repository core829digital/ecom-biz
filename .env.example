# ── Core ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://commerce:commerce@localhost:5432/commerce?schema=public"
# Serverless (Vercel + Neon): DATABASE_URL is the *pooled* URL; migrations use this direct one.
DIRECT_DATABASE_URL=""

# White-label platform name, shown in the merchant admin and system emails.
PLATFORM_NAME="Commerce"

# URL of the merchant admin / platform app (no trailing slash).
APP_URL="http://localhost:3000"

# Stores are served at <slug>.<STOREFRONT_ROOT_DOMAIN>. Custom domains are also supported.
# In development "*.localhost" resolves automatically in modern browsers.
STOREFRONT_ROOT_DOMAIN="localhost:3000"
STOREFRONT_PROTOCOL="http"

# 32+ random bytes, used to sign tokens. Generate with: openssl rand -hex 32
APP_SECRET="change-me-to-a-long-random-string"

# ── Payments (Stripe Connect) ─────────────────────────────────────────
# Leave empty to run without Stripe (manual payment methods + test gateway only).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Signing secret of the separate "Connect" webhook endpoint (connected-account events such as account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Default platform fee on each order, in basis points (100 = 1%). Plans can override.
PLATFORM_FEE_BPS="0"
# Enables the "test payment" gateway on checkouts. Never enable in production.
ENABLE_TEST_GATEWAY="true"

# ── Billing (merchant subscriptions) ─────────────────────────────────
# When true, stores without an active/trialing subscription are paused.
BILLING_ENFORCED="false"

# ── Email ─────────────────────────────────────────────────────────────
# SMTP connection URL, e.g. smtps://user:pass@smtp.example.com:465
# Leave empty to print emails to the server log.
SMTP_URL=""
EMAIL_FROM="no-reply@example.com"
# Production refuses to start without SMTP_URL. Only for a TEST deployment with no mail domain yet,
# set this to "true": the app starts but sends no emails at all. Remove it before real customers.
ALLOW_MISSING_SMTP=""

# ── File storage ──────────────────────────────────────────────────────
# "local" stores uploads in STORAGE_DIR; "s3" uses any S3-compatible bucket.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Jobs ──────────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* endpoints (webhook retries, checkout expiry).
CRON_SECRET="change-me"

# Development only: allow plain http:// webhook endpoints (e.g. a local receiver). Ignored in production.
ALLOW_HTTP_WEBHOOKS="false"

# Hostname merchants point their custom-domain CNAME to (defaults to the storefront root domain).
CUSTOM_DOMAIN_TARGET=""

# Vercel only: lets the platform add merchants' verified custom domains to the project
# (needed for routing and HTTPS). Token scope: the team that owns the project.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Seeding (npm run db:seed): optional platform admin and demo store.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_DEMO="false"

# Legal identity of the platform operator (white-label: your own company), shown on /legal pages.
# Until these are set the legal pages display a "draft" notice.
LEGAL_COMPANY_NAME=""
LEGAL_ADDRESS=""
LEGAL_VAT_NUMBER=""
LEGAL_EMAIL=""
LEGAL_DPO_EMAIL=""
# City whose courts have jurisdiction (B2B terms).
LEGAL_COURTS=""
