    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@prisma/client": "6.19.3",
    "@stripe/react-stripe-js": "7.1.0",
    "@stripe/stripe-js": "10.3.0",
    "aws4fetch": "1.0.20",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "framer-motion": "12.43.0",
    "lucide-react": "1.78.0",
